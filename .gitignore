# Live validation artifacts (may contain local paths / model raw content)
# Stable, redacted reports can be force-added if needed.
artifacts/live-validation/*
!artifacts/live-validation/README.md

# M4C benchmark artifacts (case outputs are intentionally local by default)
artifacts/agent-eval/mock/*
artifacts/agent-eval/live/*
!artifacts/agent-eval/README.md

# M5A Patch Proposal artifacts (generated, redacted, and reproducible)
artifacts/repair-proposals/mock/*
artifacts/repair-proposals/live/*
!artifacts/repair-proposals/README.md

# M5B Patch Application artifacts (generated and redacted; force-add only if needed)
artifacts/patch-applications/mock/*
artifacts/patch-applications/live/*
!artifacts/patch-applications/README.md

# M5D end-to-end benchmark artifacts (each Run is local and redacted)
artifacts/end-to-end-repair/mock/*
artifacts/end-to-end-repair/live/*
!artifacts/end-to-end-repair/README.md

# SQLite database files (M4A)
data/*.db
data/*.db-wal
data/*.db-shm
!data/.gitkeep
