# SpringFix Agent 环境变量样例
#
# 使用方法:
#   1. cp .env.example .env
#   2. 修改 .env 中的值
#   3. uv run uvicorn springfix_agent.main:app --port 8000
#
# M0/M1: 仅使用 ALLOW_ROOT
# M1.1: 加 GitHub Actions / verify_sample_bug
# M2: 加 LLM_* 配置（默认 mock 模式，无需 API Key）
# M3: 加 RETRIEVAL_* 配置

# === 基础配置 ===

# 系统允许访问的仓库根目录（绝对路径或相对项目根的路径）
# 所有用户提交的 repository_path 必须位于此根目录的子树内
ALLOW_ROOT=./samples

# 服务监听端口
HOST=0.0.0.0
PORT=8000

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# === LLM 配置 (M2) ===
#
# 默认使用 mock 模式，不需要任何 API Key，Pytest 和 CI 全部通过。
# 真实模型测试时改为 openai_compatible 并填写以下配置。
#
# 支持 OpenAI-compatible 端点；基础主机地址缺少 /v1 时会自动补全。
# 不要把真实 API Key 提交到 Git。.env 已被 .gitignore 排除。

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2000

# === 检索配置 (M3) ===
#
# 多通道代码检索模块配置。BM25 是词法检索，不是语义检索。
# 索引按任务在内存中构建，不持久化。

# 单次检索最大文件数
RETRIEVAL_MAX_FILES=200
# 单文件最大字节数
RETRIEVAL_MAX_FILE_BYTES=200000
# 最大代码块数
RETRIEVAL_MAX_CHUNKS=1000
# 返回 top-K 结果
RETRIEVAL_TOP_K=10
# 代码块最大行数
RETRIEVAL_CHUNK_MAX_LINES=60
# 代码块最大字符数
RETRIEVAL_CHUNK_MAX_CHARS=4000
# 代码块重叠行数
RETRIEVAL_CHUNK_OVERLAP_LINES=5
# 查询最大词数
RETRIEVAL_MAX_QUERY_TERMS=50
