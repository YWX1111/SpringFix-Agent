# SpringFix Agent M0 环境变量样例
#
# 使用方法:
#   1. cp .env.example .env
#   2. 修改 .env 中的值
#   3. uv run uvicorn springfix_agent.main:app --port 8000
#
# M0 阶段仅使用 ALLOW_ROOT 一个变量。
# LLM 相关配置（LLM_MOCK / LLM_API_KEY / LLM_BASE_URL / LLM_MODEL）推迟到 M2。

# 系统允许访问的仓库根目录（绝对路径或相对项目根的路径）
# 所有用户提交的 repository_path 必须位于此根目录的子树内
# M1 起强制校验
ALLOW_ROOT=./samples

# 服务监听端口
HOST=0.0.0.0
PORT=8000

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# 应用版本（仅用于健康检查响应,与 pyproject.toml 中的 version 保持一致）
APP_VERSION=0.1.0
